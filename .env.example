# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible Chat Completions endpoint works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# USD per 1M tokens, used only for cost reporting
LLM_PRICE_INPUT_PER_MTOK=0.15
LLM_PRICE_OUTPUT_PER_MTOK=0.60
LLM_TIMEOUT_S=30

# Retrieval
TOP_K=5
MIN_RELEVANCE=0.35

# Uploads
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=300

# Optional: protect write endpoints (upload/delete). Leave empty to disable.
ADMIN_TOKEN=
